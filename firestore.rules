rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /categories/{id} { allow read: if true; allow write: if false; }
    match /users/{uid} {
      allow read, create, update: if owner(uid);
      allow delete: if false;
      match /cart/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && request.resource.data.quantity is int && request.resource.data.quantity >= 1 && request.resource.data.quantity <= 99;
      }
      // Orders are saved by the signed-in browser, as in the original checkout.
      // This enforces ownership; it does not prove payment with Stripe.
      match /orders/{sessionId} {
        allow read: if owner(uid);
        allow create: if owner(uid) && request.resource.data.sessionId == sessionId;
        allow update, delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
